{
  "name": "lizzy-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts test",
    "format": "biome check --write src scripts test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
